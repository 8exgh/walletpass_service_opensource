# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1

# API Authentication (comma-separated list of accepted keys)
API_KEYS=your_api_key_1,your_api_key_2

# Apple Developer
PASS_TYPE_ID=pass.com.yourcompany.generic
TEAM_ID=ABCDEF1234
CERT_PATH=./certificates/pass-cert.p12
CERT_PASSWORD=your_certificate_password
WWDR_PATH=./certificates/wwdr.pem

# Storage
TEMP_DIR=./temp
PASSES_DIR=./generated-passes
PASS_TTL=3600

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=info
